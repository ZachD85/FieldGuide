rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // The public website may display the curated catalog and announcements.
    match /artifacts/{appId}/public/data/clinicalResources/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/systemAnnouncements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/clinicalResources_ingestionTest/{document=**} {
      allow read, write: if isAdmin();
    }

    // Configuration, test collections, Admin writes, and every unspecified
    // path are server-only. Firebase Admin/service accounts bypass these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
